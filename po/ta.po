#: prefs.js:39
msgid "Main Pill"
msgstr "முக்கிய மாத்திரை"

#: prefs.js:45
msgid "General Settings"
msgstr "பொது அமைப்புகள்"

#: prefs.js:48
msgid "Always ON"
msgstr "எப்போதும் இயக்கத்தில் இருக்கும்"

#: prefs.js:49
msgid "Retain last known track and keep pill visible after closing the player"
msgstr ""
"கடைசியாக அறியப்பட்ட டிராக்கைத் தக்கவைத்து, பிளேயரை மூடிய பிறகு மாத்திரையைப் பார்க்கவும்"

#: prefs.js:61
msgid "Show Album Art"
msgstr "ஆல்பம் கலையைக் காட்டு"

#: prefs.js:62
msgid "Display the cover art of the currently playing song"
msgstr "தற்போது இசைக்கப்படும் பாடலின் அட்டைப்படத்தைக் காட்டு"

#: prefs.js:73
msgid "Fallback Album Art"
msgstr "ஃபால்பேக் ஆல்பம் கலை"

#: prefs.js:74 prefs.js:114
msgid "No image selected"
msgstr "படம் எதுவும் தேர்ந்தெடுக்கப்படவில்லை"

#: prefs.js:84
msgid "Select Fallback Image"
msgstr "ஃபால்பேக் படத்தைத் தேர்ந்தெடுக்கவும்"

#: prefs.js:128
msgid "Enable Scroll Controls"
msgstr "உருள் கட்டுப்பாடுகளை இயக்கவும்"

#: prefs.js:129
msgid "Change Tracks, Volume or Media Player using scroll wheel or touchpad"
msgstr ""
"ச்க்ரோல் வீல் அல்லது டச்பேடைப் பயன்படுத்தி டிராக்குகள், வால்யூம் அல்லது மீடியா பிளேயரை "
"மாற்றவும்"

#: prefs.js:140
msgid "Change Track"
msgstr "தடத்தை மாற்றவும்"

#: prefs.js:141
msgid "Change Volume"
msgstr "ஒலியளவை மாற்றவும்"

#: prefs.js:142
msgid "Switch Player"
msgstr "பிளேயரை மாற்றவும்"

#: prefs.js:143
msgid "Seek ±10s"
msgstr "சீக் ±10வி"

#: prefs.js:152
msgid "Scroll Action"
msgstr "ச்க்ரோல் செயல்"

#: prefs.js:153
msgid "Choose what scrolling on the pill should do"
msgstr "மாத்திரையில் என்ன ச்க்ரோலிங் செய்ய வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்"

#: prefs.js:179
msgid "Invert Scroll Animation"
msgstr "தலைகீழ் ச்க்ரோல் அனிமேசன்"

#: prefs.js:180
msgid "Direction of the jump effect (Natural vs Traditional)"
msgstr "சம்ப் விளைவின் திசை (இயற்கை vs பாரம்பரியம்)"

#: prefs.js:191
msgid "Invert Scroll Direction"
msgstr "ச்க்ரோல் திசையை மாற்றவும்"

#: prefs.js:192
msgid "Swap up/down scrolling for track and volume actions"
msgstr "டிராக் மற்றும் வால்யூம் செயல்களுக்கு மேல்/கீழ் ச்க்ரோலிங்கை மாற்றவும்"

#: prefs.js:204
msgid "Scrolling Text"
msgstr "ச்க்ரோலிங் உரை"

#: prefs.js:205
msgid "Animate long track titles and artist names"
msgstr "நீண்ட பாடல் தலைப்புகள் மற்றும் கலைஞர் பெயர்களை அனிமேட் செய்யவும்"

#: prefs.js:216
msgid "Scroll Only on Hover"
msgstr "ஓவரில் மட்டும் உருட்டவும்"

#: prefs.js:217
msgid "Text stays still until you hover the pill"
msgstr "மாத்திரையை எடுத்து வைக்கும் வரை உரை அசையாமல் இருக்கும்"

#: prefs.js:229
msgid "Freeze Scroll on Pause"
msgstr "இடைநிறுத்தத்தில் உருட்டலை முடக்கு"

#: prefs.js:230
msgid "Stop the text scrolling animation when the media player is paused"
msgstr "மீடியா பிளேயர் இடைநிறுத்தப்படும் போது உரை ச்க்ரோலிங் அனிமேசனை நிறுத்தவும்"

#: prefs.js:243
msgid "Lyrics Display"
msgstr "பாடல் வரிகள் காட்சி"

#: prefs.js:244
msgid "Show real-time synchronized lyrics for current track."
msgstr "தற்போதைய டிராக்கிற்கான நிகழ்நேர ஒத்திசைக்கப்பட்ட பாடல் வரிகளைக் காட்டு."

#: prefs.js:255
msgid "Lyrics language preference"
msgstr "பாடல் வரிகள் மொழி விருப்பம்"

#: prefs.js:256
msgid "When multiple versions exist"
msgstr "பல பதிப்புகள் இருக்கும்போது"

#: prefs.js:258
msgid "Auto"
msgstr "தானி"

#: prefs.js:259
msgid "Prefer original script"
msgstr "அசல் ச்கிரிப்டை விரும்பு"

#: prefs.js:260
msgid "Prefer Latin"
msgstr "லத்தீன் மொழிக்கு முன்னுரிமை கொடுங்கள்"

#: prefs.js:269
msgid "Lyrics Fade-in Effect"
msgstr "பாடல் வரிகள் ஃபேட்-இன் எஃபெக்ட்"

#: prefs.js:270
msgid "Smoothly fade in new lyric lines"
msgstr "புதிய பாடல் வரிகளில் மென்மையாக மங்கிவிடும்"

#: prefs.js:282
msgid "Fade Duration (ms)"
msgstr "மங்கல் கால அளவு (மிவி)"

#: prefs.js:291
msgid "Tablet Mode Controls"
msgstr "டேப்லெட் பயன்முறை கட்டுப்பாடுகள்"

#: prefs.js:292
msgid "Show media buttons directly on the pill"
msgstr "மாத்திரையில் நேரடியாக மீடியா பொத்தான்களைக் காட்டு"

#: prefs.js:294
msgid "Off"
msgstr "அணை"

#: prefs.js:294
msgid "Skip Only"
msgstr "தவிர் மட்டும்"

#: prefs.js:294
msgid "Play/Pause Only"
msgstr "விளையாட/இடைநிறுத்த மட்டும்"

#: prefs.js:294
msgid "All Controls"
msgstr "அனைத்து கட்டுப்பாடுகள்"

#: prefs.js:303
msgid "Controls Position"
msgstr "கட்டுப்பாட்டு நிலை"

#: prefs.js:304
msgid "Where to place the tablet controls on the pill"
msgstr "மாத்திரை கட்டுப்பாடுகளை மாத்திரையில் எங்கு வைக்க வேண்டும்"

#: prefs.js:306
msgid "Before Text"
msgstr "உரைக்கு முன்"

#: prefs.js:306
msgid "After Text"
msgstr "உரைக்குப் பிறகு"

#: prefs.js:306
msgid "After Visualizer"
msgstr "விசுவலைசருக்குப் பிறகு"

#: prefs.js:320
msgid "Inline Artist"
msgstr "இன்லைன் கலைஞர்"

#: prefs.js:320
msgid "Show \"Title • Artist\" when the widget is squeezed"
msgstr "விட்செட்டை அழுத்தும் போது \"தலைப்பு • கலைஞர்\" என்பதைக் காட்டு"

#: prefs.js:326
msgid "Show Artist"
msgstr "கலைஞரைக் காட்டு"

#: prefs.js:326
msgid "Show the artist name in the main music pill"
msgstr "முக்கிய இசை மாத்திரையில் கலைஞரின் பெயரைக் காட்டு"

#: prefs.js:338
msgid "Compact Mode (Hide Text)"
msgstr "கச்சிதமான பயன்முறை (உரையை மறை)"

#: prefs.js:339
msgid "Hide title and artist"
msgstr "தலைப்பையும் கலைஞரையும் மறை"

#: prefs.js:352
msgid "Mouse Actions"
msgstr "சுட்டி செயல்கள்"

#: prefs.js:355 prefs.js:675
msgid "None"
msgstr "எதுவுமில்லை"

#: prefs.js:355
msgid "Play / Pause"
msgstr "விளையாடு / இடைநிறுத்து"

#: prefs.js:355
msgid "Next Track"
msgstr "அடுத்த ட்ராக்"

#: prefs.js:355
msgid "Previous Track"
msgstr "முந்தைய ட்ராக்"

#: prefs.js:356
msgid "Open Player App"
msgstr "பிளேயர் பயன்பாட்டைத் திறக்கவும்"

#: prefs.js:356
msgid "Open Menu"
msgstr "மெனுவைத் திற"

#: prefs.js:356
msgid "Select Player"
msgstr "பிளேயரைத் தேர்ந்தெடுக்கவும்"

#: prefs.js:356
msgid "Open Settings"
msgstr "அமைப்புகளைத் திறக்கவும்"

#: prefs.js:356
msgid "Close Player App"
msgstr "பிளேயர் பயன்பாட்டை மூடு"

#: prefs.js:363
msgid "Left Click"
msgstr "இடது சொடுக்கு செய்யவும்"

#: prefs.js:371
msgid "Double Click"
msgstr "இருமுறை சொடுக்கு செய்யவும்"

#: prefs.js:379
msgid "Middle Click"
msgstr "மிடில் சொடுக்கு"

#: prefs.js:387
msgid "Right Click"
msgstr "வலது சொடுக்கு செய்யவும்"

#: prefs.js:395
msgid "Hover Action"
msgstr "மிதவை நடவடிக்கை"

#: prefs.js:406
msgid "Hover Delay (ms)"
msgstr "மிதவை நேரந்தவறுகை (மிவி)"

#: prefs.js:420
msgid "Pop-up Menu"
msgstr "பாப்-அப் பட்டியல்"

#: prefs.js:424
msgid "Pop-up Appearance"
msgstr "பாப்-அப் தோற்றம்"

#: prefs.js:426
msgid "Rotate Vinyl"
msgstr "வினைலை சுழற்று"

#: prefs.js:427
msgid "Spin the album art when playing"
msgstr "விளையாடும் போது ஆல்பம் கலையை சுழற்றவும்"

#: prefs.js:438
msgid "Rotation Speed"
msgstr "சுழற்சி விரைவு"

#: prefs.js:439
msgid "Adjust the vinyl spin speed (Lower is slower, Default: 10)"
msgstr "வினைல் சுழல் வேகத்தை சரிசெய்யவும் (குறைவானது மெதுவாக உள்ளது, இயல்புநிலை: 10)"

#: prefs.js:447 prefs.js:867
msgid "Enable Shadow"
msgstr "நிழலை இயக்கு"

#: prefs.js:448
msgid "Show drop shadow behind the pop-up menu"
msgstr "பாப்-அப் மெனுவின் பின்னால் துளி நிழலைக் காட்டு"

#: prefs.js:459
msgid "Close on Mouse Leave"
msgstr "மவுச் லீவில் மூடு"

#: prefs.js:460
msgid "Automatically hide the pop-up when you move the cursor away"
msgstr "கர்சரை நகர்த்தும்போது தானாகவே பாப்-அப்பை மறைக்கவும்"

#: prefs.js:471
msgid "Follow Custom Background Color"
msgstr "தனிப்பயன் பின்னணி வண்ணத்தைப் பின்பற்றவும்"

#: prefs.js:472
msgid "Use the custom background color for the pop-up (if active)"
msgstr "பாப்-அப்பிற்கு தனிப்பயன் பின்னணி வண்ணத்தைப் பயன்படுத்தவும் (செயலில் இருந்தால்)"

#: prefs.js:481
msgid "Follow Custom Text Color"
msgstr "தனிப்பயன் உரை வண்ணத்தைப் பின்பற்றவும்"

#: prefs.js:482
msgid "Use the custom text color for the pop-up (if active)"
msgstr "பாப்-அப்பிற்கு தனிப்பயன் உரை வண்ணத்தைப் பயன்படுத்தவும் (செயலில் இருந்தால்)"

#: prefs.js:491
msgid "Follow Transparency"
msgstr "வெளிப்படைத்தன்மையைப் பின்பற்றவும்"

#: prefs.js:492
msgid "Inherit opacity settings from the main pill"
msgstr "முதன்மையான மாத்திரையிலிருந்து ஒளிபுகா அமைப்புகளைப் பெறவும்"

#: prefs.js:503
msgid "Follow Border Radius"
msgstr "பார்டர் ரேடியசைப் பின்தொடரவும்"

#: prefs.js:504
msgid "Inherit corner roundness from the main pill"
msgstr "முதன்மையான மாத்திரையிலிருந்து மூலையின் வட்டத்தன்மையைப் பெறுங்கள்"

#: prefs.js:513
msgid "Show Vinyl"
msgstr "வினைலைக் காட்டு"

#: prefs.js:513
msgid "Display the album art in the pop-up"
msgstr "பாப்-அப்பில் ஆல்பம் கலையைக் காட்டு"

#: prefs.js:519
msgid "Square Vinyl Image"
msgstr "சதுர வினைல் படம்"

#: prefs.js:519
msgid "Use a square album art (disables rotation)"
msgstr "சதுர ஆல்பம் கலையைப் பயன்படுத்தவும் (சுழற்சியை முடக்குகிறது)"

#: prefs.js:525
msgid "Album Art Shadow"
msgstr ""

#: prefs.js:525
msgid "Show drop shadow behind the album art in the pop-up"
msgstr ""

#: prefs.js:531
msgid "Show Shuffle and Loop"
msgstr "சஃபிள் மற்றும் லூப்பைக் காட்டு"

#: prefs.js:531
msgid "Display extra controls in the pop-up"
msgstr "பாப்-அப்பில் கூடுதல் கட்டுப்பாடுகளைக் காண்பி"

#: prefs.js:537
msgid "Use Custom Width"
msgstr "தனிப்பயன் அகலத்தைப் பயன்படுத்தவும்"

#: prefs.js:537
msgid "Disable dynamic sizing for the pop-up"
msgstr "பாப்-அப்பிற்கான மாறும் அளவை முடக்கு"

#: prefs.js:544
msgid "Custom Width Value"
msgstr "தனிப்பயன் அகல மதிப்பு"

#: prefs.js:560
msgid "Show Player Selector"
msgstr "பிளேயர் தேர்வாளரைக் காட்டு"

#: prefs.js:561
msgid "Display active player icons in the pop-up"
msgstr "பாப்-அப்பில் செயலில் உள்ள பிளேயர் ஐகான்களைக் காண்பி"

#: prefs.js:569
msgid "Hide Auto (Smart Selection)"
msgstr "ஆட்டோவை மறை (ச்மார்ட் தேர்வு)"

#: prefs.js:570
msgid ""
"Remove the automatic player selection entry from the player selector menu"
msgstr "பிளேயர் தேர்வாளர் மெனுவிலிருந்து தானியங்கி பிளேயர் தேர்வு உள்ளீட்டை அகற்றவும்"

#: prefs.js:581
msgid "Player Selector Position"
msgstr "வீரர் தேர்வாளர் நிலை"

#: prefs.js:582
msgid "Where to place the player icons inside the pop-up"
msgstr "பாப்-அப்பில் பிளேயர் ஐகான்களை எங்கு வைக்க வேண்டும்"

#: prefs.js:583
msgid "Top"
msgstr "மேலே"

#: prefs.js:583
msgid "Bottom"
msgstr "கீழே"

#: prefs.js:583
msgid "Left"
msgstr "இடது"

#: prefs.js:583
msgid "Right"
msgstr "வலது"

#: prefs.js:594
msgid "Show Album Title"
msgstr "ஆல்பத்தின் தலைப்பைக் காட்டு"

#: prefs.js:595
msgid "Display album name next to the artist (Artist • Album)"
msgstr "கலைஞருக்கு அருகில் ஆல்பத்தின் பெயரைக் காண்பி (கலைஞர் • ஆல்பம்)"

#: prefs.js:603
msgid "Show HH:MM:SS"
msgstr "HH:MM:SSஐக் காட்டு"

#: prefs.js:604
