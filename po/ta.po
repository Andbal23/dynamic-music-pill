#: prefs.js:518
msgid "Main Pill"
msgstr "முக்கிய மாத்திரை"

#: prefs.js:524
msgid "General Settings"
msgstr "பொது அமைப்புகள்"

#: prefs.js:529
msgid "Always ON"
msgstr "எப்போதும் இயக்கத்தில் இருக்கும்"

#: prefs.js:530
msgid "Retain last known track and keep pill visible after closing the player"
msgstr ""
"கடைசியாக அறியப்பட்ட டிராக்கைத் தக்கவைத்து, பிளேயரை மூடிய பிறகு மாத்திரையைப் பார்க்கவும்"

#: prefs.js:538
msgid "Show Album Art"
msgstr "ஆல்பம் கலையைக் காட்டு"

#: prefs.js:539
msgid "Display the cover art of the currently playing song"
msgstr "தற்போது இசைக்கப்படும் பாடலின் அட்டைப்படத்தைக் காட்டு"

#: prefs.js:544
msgid "Fallback Album Art"
msgstr "ஃபால்பேக் ஆல்பம் கலை"

#: prefs.js:545 prefs.js:585 prefs.js:589
msgid "No image selected"
msgstr "படம் எதுவும் தேர்ந்தெடுக்கப்படவில்லை"

#: prefs.js:555
msgid "Select Fallback Image"
msgstr "ஃபால்பேக் படத்தைத் தேர்ந்தெடுக்கவும்"

#: prefs.js:604
msgid "Show Artist"
msgstr "கலைஞரைக் காட்டு"

#: prefs.js:605
msgid "Show the artist name in the main music pill"
msgstr "முக்கிய இசை மாத்திரையில் கலைஞரின் பெயரைக் காட்டு"

#: prefs.js:611
msgid "Inline Artist"
msgstr "இன்லைன் கலைஞர்"

#: prefs.js:612
msgid "Show \"Title • Artist\" when the widget is squeezed"
msgstr "விட்செட்டை அழுத்தும் போது \"தலைப்பு • கலைஞர்\" என்பதைக் காட்டு"

#: prefs.js:620
msgid "Compact Mode (Hide Text)"
msgstr "கச்சிதமான பயன்முறை (உரையை மறை)"

#: prefs.js:621
msgid "Hide title and artist"
msgstr "தலைப்பையும் கலைஞரையும் மறை"

#: prefs.js:629
msgid "Scrolling Text"
msgstr "ச்க்ரோலிங் உரை"

#: prefs.js:630
msgid "Animate long track titles and artist names"
msgstr "நீண்ட பாடல் தலைப்புகள் மற்றும் கலைஞர் பெயர்களை அனிமேட் செய்யவும்"

#: prefs.js:636
msgid "Scroll Only on Hover"
msgstr "ஓவரில் மட்டும் உருட்டவும்"

#: prefs.js:637
msgid "Text stays still until you hover the pill"
msgstr "மாத்திரையை எடுத்து வைக்கும் வரை உரை அசையாமல் இருக்கும்"

#: prefs.js:644
msgid "Freeze Scroll on Pause"
msgstr "இடைநிறுத்தத்தில் உருட்டலை முடக்கு"

#: prefs.js:645
msgid "Stop the text scrolling animation when the media player is paused"
msgstr "மீடியா பிளேயர் இடைநிறுத்தப்படும் போது உரை ச்க்ரோலிங் அனிமேசனை நிறுத்தவும்"

#: prefs.js:655
msgid "Positioning"
msgstr "நிலைப்படுத்துதல்"

#: prefs.js:660
msgid "Container Target"
msgstr "கொள்கலன் இலக்கு"

#: prefs.js:661
msgid "Select which UI element should host the music pill"
msgstr ""
"எந்த இடைமுகம் உறுப்பு இசை மாத்திரையை புரவலன் செய்ய வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்"

#: prefs.js:663
msgid "Dock"
msgstr "கப்பல் கூடம்"

#: prefs.js:663
msgid "Panel: Left Box"
msgstr "குழு: இடது பெட்டி"

#: prefs.js:663
msgid "Panel: Center Box"
msgstr "குழு: மையப் பெட்டி"

#: prefs.js:663
msgid "Panel: Right Box"
msgstr "குழு: வலது பெட்டி"

#: prefs.js:669
msgid "Multi-Monitor Docks"
msgstr "பல-திரை டாக்குகள்"

#: prefs.js:670
msgid "Which docks show the pill when the dock is on all monitors"
msgstr ""
"அனைத்துத் திரைகளிலும் டாக் இருக்கும்போது எந்த டாக்குகளில் மாத்திரையைக் காட்ட வேண்டும்"

#: prefs.js:672
msgid "Main Dock Only"
msgstr "முதன்மை டாக் மட்டும்"

#: prefs.js:672
msgid "All Docks"
msgstr "அனைத்து டாக்குகளும்"

#: prefs.js:672
msgid "Secondary Docks Only"
msgstr "இரண்டாம் நிலை டாக்குகள் மட்டும்"

#: prefs.js:678
msgid "Dynamic Width"
msgstr "மாறும் அகலம்"

#: prefs.js:679
msgid "Auto-adjust pill width (slider acts as max width)"
msgstr "மாத்திரை அகலத்தை தானாக சரிசெய்தல் (ச்லைடர் அதிகபட்ச அகலமாக செயல்படுகிறது)"

#: prefs.js:686
msgid "Alignment Preset"
msgstr "சீரமைப்பு முன்னமைவு"

#: prefs.js:687
msgid "How the widget aligns relative to other items"
msgstr "மற்ற உருப்படிகளுடன் ஒப்பிடும்போது விட்செட் எவ்வாறு சீரமைக்கப்படுகிறது"

#: prefs.js:689
msgid "Manual Index"
msgstr "கையேடு குறியீடு"

#: prefs.js:689
msgid "First (Start)"
msgstr "முதலில் (தொடங்கு)"

#: prefs.js:689
msgid "Center"
msgstr "நடுவண்"

#: prefs.js:689
msgid "Last (End)"
msgstr "கடைசி (முடிவு)"

#: prefs.js:695
msgid "Manual Index Position"
msgstr "கையேடு குறியீட்டு நிலை"

#: prefs.js:696
msgid "Order in the list (0 is first). Only for Manual mode."
msgstr "பட்டியலில் உள்ள வரிசை (0 முதல்). கைமுறை பயன்முறைக்கு மட்டுமே."

#: prefs.js:710 prefs.js:928
msgid "Vertical Offset (Y)"
msgstr "செங்குத்து ஆஃப்செட் (Y)"

#: prefs.js:711 prefs.js:929
msgid "Shift Up (-) or Down (+)"
msgstr "மேலே (-) அல்லது கீழ் (+)"

#: prefs.js:720 prefs.js:938
msgid "Horizontal Offset (X)"
msgstr "கிடைமட்ட ஆஃப்செட் (X)"

#: prefs.js:721 prefs.js:939
msgid "Shift Left (-) or Right (+)"
msgstr "இடது (-) அல்லது வலது (+)"

#: prefs.js:730
msgid "Start Margin (Left / Top)"
msgstr ""

#: prefs.js:731
msgid "Outer spacing before the pill in the dock or panel"
msgstr ""

#: prefs.js:740
msgid "End Margin (Right / Bottom)"
msgstr ""

#: prefs.js:741
msgid "Outer spacing after the pill in the dock or panel"
msgstr ""

#: prefs.js:752
msgid "Dimensions (Dock Mode)"
msgstr "பரிமாணங்கள் (டாக் பயன்முறை)"

#: prefs.js:756 prefs.js:783
msgid "Album Art Size"
msgstr "ஆல்பம் கலை அளவு"

#: prefs.js:763 prefs.js:790
msgid "Widget Width"
msgstr "விட்செட் அகலம்"

#: prefs.js:770 prefs.js:797
msgid "Widget Height"
msgstr "விட்செட் உயரம்"

#: prefs.js:779
msgid "Dimensions (Panel Mode)"
msgstr "பரிமாணங்கள் (பேனல் பயன்முறை)"

#: prefs.js:798
msgid "Set to 32 or higher to display Title above Artist on two lines"
msgstr ""

#: prefs.js:823
msgid "Pop-up Menu"
msgstr "பாப்-அப் பட்டியல்"

#: prefs.js:829
msgid "Pop-up Appearance"
msgstr "பாப்-அப் தோற்றம்"

#: prefs.js:834
msgid "Close on Mouse Leave"
msgstr "மவுச் லீவில் மூடு"

#: prefs.js:835
msgid "Automatically hide the pop-up when you move the cursor away"
msgstr "கர்சரை நகர்த்தும்போது தானாகவே பாப்-அப்பை மறைக்கவும்"

#: prefs.js:842
msgid "Show Album Title"
msgstr "ஆல்பத்தின் தலைப்பைக் காட்டு"

#: prefs.js:843
msgid "Display album name next to the artist (Artist • Album)"
msgstr "கலைஞருக்கு அருகில் ஆல்பத்தின் பெயரைக் காண்பி (கலைஞர் • ஆல்பம்)"

#: prefs.js:850
msgid "Show HH:MM:SS"
msgstr "HH:MM:SSஐக் காட்டு"

#: prefs.js:851
msgid "Display hours in the time labels when media is longer than 60 minutes"
msgstr ""
"மீடியா 60 நிமிடங்களுக்கு மேல் இருக்கும் போது நேர லேபிள்களில் மணிநேரத்தைக் காட்டவும்"

#: prefs.js:858 prefs.js:2046
msgid "Enable Shadow"
msgstr "நிழலை இயக்கு"

#: prefs.js:859
msgid "Show drop shadow behind the pop-up menu"
msgstr "பாப்-அப் மெனுவின் பின்னால் துளி நிழலைக் காட்டு"

#: prefs.js:866
msgid "Follow Transparency"
msgstr "வெளிப்படைத்தன்மையைப் பின்பற்றவும்"

#: prefs.js:867
msgid "Inherit opacity settings from the main pill"
msgstr "முதன்மையான மாத்திரையிலிருந்து ஒளிபுகா அமைப்புகளைப் பெறவும்"

#: prefs.js:874
msgid "Follow Border Radius"
msgstr "பார்டர் ரேடியசைப் பின்தொடரவும்"

#: prefs.js:875
msgid "Inherit corner roundness from the main pill"
msgstr "முதன்மையான மாத்திரையிலிருந்து மூலையின் வட்டத்தன்மையைப் பெறுங்கள்"

#: prefs.js:882
msgid "Follow Custom Background Color"
msgstr "தனிப்பயன் பின்னணி வண்ணத்தைப் பின்பற்றவும்"

#: prefs.js:883
msgid "Use the custom background color for the pop-up (if active)"
msgstr "பாப்-அப்பிற்கு தனிப்பயன் பின்னணி வண்ணத்தைப் பயன்படுத்தவும் (செயலில் இருந்தால்)"

#: prefs.js:890
msgid "Follow Custom Text Color"
msgstr "தனிப்பயன் உரை வண்ணத்தைப் பின்பற்றவும்"

#: prefs.js:891
msgid "Use the custom text color for the pop-up (if active)"
msgstr "பாப்-அப்பிற்கு தனிப்பயன் உரை வண்ணத்தைப் பயன்படுத்தவும் (செயலில் இருந்தால்)"

#: prefs.js:899
msgid "Use Custom Width"
msgstr "தனிப்பயன் அகலத்தைப் பயன்படுத்தவும்"

#: prefs.js:900
msgid "Disable dynamic sizing for the pop-up"
msgstr "பாப்-அப்பிற்கான மாறும் அளவை முடக்கு"

#: prefs.js:906
msgid "Custom Width Value"
msgstr "தனிப்பயன் அகல மதிப்பு"

#: prefs.js:949
msgid "Show Vinyl"
msgstr "வினைலைக் காட்டு"

#: prefs.js:950
msgid "Display the album art in the pop-up"
msgstr "பாப்-அப்பில் ஆல்பம் கலையைக் காட்டு"

#: prefs.js:956
msgid "Square Vinyl Image"
msgstr "சதுர வினைல் படம்"

#: prefs.js:957
msgid "Use a square album art (disables rotation)"
msgstr "சதுர ஆல்பம் கலையைப் பயன்படுத்தவும் (சுழற்சியை முடக்குகிறது)"

#: prefs.js:964
msgid "Album Art Shadow"
msgstr ""

#: prefs.js:965
msgid "Show drop shadow behind the album art in the pop-up"
msgstr ""

#: prefs.js:972
msgid "Rotate Vinyl"
msgstr "வினைலை சுழற்று"

#: prefs.js:973
msgid "Spin the album art when playing"
msgstr "விளையாடும் போது ஆல்பம் கலையை சுழற்றவும்"

#: prefs.js:979
msgid "Rotation Speed"
msgstr "சுழற்சி விரைவு"

#: prefs.js:980
msgid "Adjust the vinyl spin speed (Lower is slower, Default: 10)"
msgstr "வினைல் சுழல் வேகத்தை சரிசெய்யவும் (குறைவானது மெதுவாக உள்ளது, இயல்புநிலை: 10)"

#: prefs.js:1004
msgid "Show Player Selector"
msgstr "பிளேயர் தேர்வாளரைக் காட்டு"

#: prefs.js:1005
msgid "Display active player icons in the pop-up"
msgstr "பாப்-அப்பில் செயலில் உள்ள பிளேயர் ஐகான்களைக் காண்பி"

#: prefs.js:1011
msgid "Player Selector Position"
msgstr "வீரர் தேர்வாளர் நிலை"

#: prefs.js:1012
msgid "Where to place the player icons inside the pop-up"
msgstr "பாப்-அப்பில் பிளேயர் ஐகான்களை எங்கு வைக்க வேண்டும்"

#: prefs.js:1013
msgid "Top"
msgstr "மேலே"

#: prefs.js:1013
msgid "Bottom"
msgstr "கீழே"

#: prefs.js:1013
msgid "Left"
msgstr "இடது"

#: prefs.js:1013
msgid "Right"
msgstr "வலது"

#: prefs.js:1020
msgid "Hide Auto (Smart Selection)"
msgstr "ஆட்டோவை மறை (ச்மார்ட் தேர்வு)"

#: prefs.js:1021
msgid ""
"Remove the automatic player selection entry from the player selector menu"
msgstr "பிளேயர் தேர்வாளர் மெனுவிலிருந்து தானியங்கி பிளேயர் தேர்வு உள்ளீட்டை அகற்றவும்"

#: prefs.js:1031
msgid "Custom Control Buttons"
msgstr "தனிப்பயன் கட்டுப்பாட்டு பொத்தான்கள்"

#: prefs.js:1032
msgid "Add up to two extra buttons in the expanded player's controls row."
msgstr ""
"விரிவாக்கப்பட்ட பிளேயரின் கட்டுப்பாடுகள் வரிசையில் இரண்டு கூடுதல் பொத்தான்களைச் சேர்க்கவும்."

#: prefs.js:1033
msgid ""
"If both buttons are set to Seek, they act directly (Button 1 = −10s, Button "
"2 = +10s). Otherwise Seek opens a sub-page."
msgstr ""
"இரண்டு பொத்தான்களும் சீக் என அமைக்கப்பட்டால், அவை நேரடியாகச் செயல்படும் (பட்டன் 1 = -10கள், "
"பட்டன் 2 = +10கள்). இல்லையெனில் சீக் ஒரு துணைப் பக்கத்தைத் திறக்கும்."

#: prefs.js:1038
msgid "Show Shuffle and Loop"
msgstr "சஃபிள் மற்றும் லூப்பைக் காட்டு"

#: prefs.js:1039
msgid "Display extra controls in the pop-up"
msgstr "பாப்-அப்பில் கூடுதல் கட்டுப்பாடுகளைக் காண்பி"

#: prefs.js:1046
msgid "Enable Custom Buttons"
msgstr "தனிப்பயன் பொத்தான்களை இயக்கு"

#: prefs.js:1047
msgid "Show additional action buttons next to Shuffle and Loop"
msgstr "சஃபிள் மற்றும் லூப்பிற்கு அடுத்துள்ள கூடுதல் செயல் பொத்தான்களைக் காட்டு"

#: prefs.js:1052 prefs.js:1101
msgid "None"
msgstr "எதுவுமில்லை"

#: prefs.js:1053
msgid "Volume Control"
msgstr "தொகுதி கட்டுப்பாடு"

#: prefs.js:1054
msgid "Seek ±10 Seconds"
